# Copy these into the `.env` of the reachy_mini_conversation_app folder.
# Only REACHY_MINI_CUSTOM_PROFILE is required to make it boot as Vibey.

# Auto-load the Vibey personality profile at startup
REACHY_MINI_CUSTOM_PROFILE=vibey

# LLM / realtime voice backend: huggingface (default, no key) | openai | gemini
BACKEND_PROVIDER=huggingface

# Only needed if you switch BACKEND_PROVIDER above:
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional model override (leave blank for backend default)
# MODEL_NAME=

# Spoken language (backend-supported code, e.g. en, zh, es)
# REALTIME_TRANSCRIPTION_LANGUAGE=en
